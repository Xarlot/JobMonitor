# Telemetry build-time credentials.
#
# Copy to `.env.telemetry` (gitignored) for local builds, or set these as CI secrets.
# `vite.telemetry.config.ts` substitutes them into electron/telemetry.bundle.mjs at build time —
# they cannot be read from the environment at runtime, because nothing on a user's machine will
# have set them.
#
# A build with these unset is not an error: it produces an app that aggregates locally and refuses
# to publish (see `assertConfigured` in packages/telemetry-schema/src/channel.ts). That is the right
# behaviour for a contributor's checkout, and it is why there is no fallback to a shared key.

# Ably key with capability {"jobmonitor:telemetry:v1": ["publish"]}.
#
# This one credential ships inside every installer, so treat it as public and make it incapable of
# anything that would matter. Verify a new key behaviourally before trusting it — the declared
# capability and the enforced one are not the same claim:
#
#   publish to jobmonitor:telemetry:v1  -> 201
#   GET history on that channel         -> 401   (proves it cannot read)
#   publish to any other channel        -> 401   (proves the channel scope)
TELEMETRY_ABLY_KEY=

# Receiver public key, x-only secp256k1 hex. Telemetry is encrypted to this, so extracting the
# Ably key above never yields the ability to decrypt anything.
#
# Generate the pair with `npm run telemetry:keys`. The PRIVATE half goes to /opt/jobmonitor/
# telemetry/.env on the ingest VM (mode 0600) and to the team password manager — nowhere else.
# Losing it means every shipped client is encrypting to a key nobody holds, and recovering costs a
# release cycle.
TELEMETRY_RECEIVER_PUBKEY=

# 16 random bytes identifying this deployment's telemetry, carried inside the ciphertext. Not a
# secret; it is what stops a stranger who extracted the Ably key from writing into our dashboards.
TELEMETRY_DEPLOYMENT_ID=
