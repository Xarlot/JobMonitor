{
  "name": "@jobmonitor/telemetry-receiver",
  "version": "0.0.0",
  "private": true,
  "description": "Ably subscriber, validation pipeline and dashboards for Job Monitor telemetry",
  "scripts": {
    "dev": "next dev",
    "dev:seed": "vitest run --config vitest.scripts.config.ts scripts/seed.ts",
    "dev:ingest": "vitest run --config vitest.scripts.config.ts scripts/ingest.ts",
    "dev:publish": "vitest run --config vitest.scripts.config.ts scripts/publish.ts",
    "dev:reset": "rm -rf .data && echo \"local database removed\"",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@jobmonitor/telemetry-schema": "*",
    "@primer/octicons-react": "^19.33.0",
    "@primer/react": "^38.35.0",
    "ably": "^2.26.0",
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}
