# Local development. Copy to `.env.local` (gitignored) — Next.js loads it automatically.
#
# Two modes, and the first needs no credentials at all:
#
#   OFFLINE  npm run dev:seed && npm run dev
#            Seeds three weeks of realistic telemetry into a local database and serves the
#            dashboards from it. Ingest is unconfigured, so the "telemetry may be incomplete"
#            banner shows — which is correct, and worth seeing at least once.
#
#   LIVE     fill in the values below, then: npm run dev
#            Reads the real Ably channel. `npm run dev:publish` sends a batch through the real
#            client code path so the whole chain can be watched end to end.

# Local database. Outside /home, which only exists on App Service.
TELEMETRY_DB=./.data/telemetry.db

# ── LIVE mode only ─────────────────────────────────────────────────────────────────────────────

# Ably key with subscribe + history on jobmonitor:telemetry:v1.
#
# NOT the client's publish key. That one is deliberately publish-only and returns 401 on history —
# which is the property that keeps one installation from reading another's telemetry, so it is
# working as intended when it refuses you here.
TELEMETRY_ABLY_SUBSCRIBE_KEY=

# Receiver private key, the half that decrypts. Generate a pair with `npm run telemetry:keys` from
# the repository root; the public half goes into the client build.
TELEMETRY_RECEIVER_SECKEYS=

# Must match the client build, or every batch is rejected with `deployment-mismatch`.
TELEMETRY_DEPLOYMENT_ID=

# Any value locally — it only guards POST /api/ingest.
INGEST_TOKEN=dev

# ── Optional ───────────────────────────────────────────────────────────────────────────────────

# Ably retention for this channel, hours. 24 on the free tier. Startup refuses a schedule that
# could not survive two consecutive failures inside this window.
# ABLY_RETENTION_HOURS=24
# INGEST_INTERVAL_HOURS=8

# How stale the data must be before opening a page triggers a read. Lower it to watch the
# on-demand path fire.
# INGEST_STALENESS_MINUTES=60

# ── LIVE publishing (npm run dev:publish) ──────────────────────────────────────────────────────
#
# The client's publish-only key and the matching receiver public key, so a test batch is sealed
# exactly as a real installation would seal it.
TELEMETRY_ABLY_KEY=
TELEMETRY_RECEIVER_PUBKEY=
